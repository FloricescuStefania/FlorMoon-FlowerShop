<header>
    <nav class="navbar navbar-expand-lg px-3 shadow fixed-top">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <img src="~/Images/logo.png" alt="FlorMoon logo" width="30" height="30" class="align-text-top me-2">
                <span class="h4 mb-0 font-weight-bold">FlorMoon</span>
            </a>

            <!-- Buton Mobile Toggler -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Store" asp-action="Index">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <!-- Search Form -->
                <form class="d-flex me-3 search-form" asp-controller="Store" asp-action="Search" method="get">
                    <div class="input-group">
                        <input name="searchTerm" class="form-control border-end-0" type="search" placeholder="Search flowers..." aria-label="Search">
                        <button class="btn btn-outline-dark border-start-0" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Icons -->
                <div class="nav-icons d-flex align-items-center">

                    <!-- Wishlist -->
                    <a asp-controller="Wishlist" asp-action="Index" class="me-3 position-relative" title="Favorite">
                        <i class="far fa-heart fa-lg"></i>
                    </a>

                    <!-- Shopping Cart -->
                    <a asp-controller="ShoppingCart" asp-action="Index" class="me-3 position-relative" title="Shopping cart">
                        <i class="fas fa-shopping-cart fa-lg"></i>
                    </a>

                    <!-- User Profile -->
                    <a asp-controller="Profile" asp-action="Profile" class="me-3" title="My profile">
                        <i class="fas fa-user fa-lg"></i>
                    </a>

                    <!-- Authentification Buttons -->
                    <a class="nav-link me-2" href="#">Register</a>
                    <a class="nav-link" href="#">Login</a>

                </div>
            </div>
        </div>
    </nav>
</header>