@{
    ViewData["Title"] = "FAQ";
}

<div class="container faq-container">
    <h1 class="text-center section-title mb-5">Frequently Asked Questions</h1>

    <div class="accordion" id="faqAccordion">

        <!-- Item 1 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    <span>How should I care for my fresh flowers to make them last longer?</span>
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">Trim the stems at a 45-degree angle, change the vase water every two days, and keep them away from direct sunlight, ripening fruit, and drafts.</p>
                </div>
            </div>
        </div>

        <!-- Item 2 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingTwo">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                    <span>Do you offer same-day delivery?</span>
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">Same-day delivery is available for orders placed before 12 PM. Please note that availability may be limited on busy days or holidays.</p>
                </div>
            </div>
        </div>

        <!-- Item 3 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingThree">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                    <span>Do you deliver on weekends and holidays?</span>
                </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">No, we do not deliver on weekends and holidays. Our delivery service is available exclusively from Monday to Friday, between 10:00 and 19:00.</p>
                </div>
            </div>
        </div>

        <!-- Item 4 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingFour">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseFour">
                    <span>What payment methods do you accept?</span>
                </button>
            </h2>
            <div id="collapseFour" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">We accept credit/debit cards, PayPal, and cash on delivery.</p>
                </div>
            </div>
        </div>

        <!-- Item 5 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingFive">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseFive">
                    <span>How do I track my order?</span>
                </button>
            </h2>
            <div id="collapseFive" class="accordion-collapse collapse" aria-labelledby="headingFive" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">You can track your order through the tracking link sent to your email after purchase.</p>
                </div>
            </div>
        </div>

        <!-- Item 6 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingSix">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSix" aria-expanded="false" aria-controls="collapseSix">
                    <span>What if I want to change or cancel my order?</span>
                </button>
            </h2>
            <div id="collapseSix" class="accordion-collapse collapse" aria-labelledby="headingSix" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">Changes or cancellations must be made before 12 PM, as the bouquet may already be in preparation or out for delivery.</p>
                </div>
            </div>
        </div>

        <!-- Item 7 -->
        <div class="accordion-item accordion-item-custom mb-3">
            <h2 class="accordion-header" id="headingSeven">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSeven" aria-expanded="false" aria-controls="collapseSeven">
                    <span>Can I return or exchange flowers?</span>
                </button>
            </h2>
            <div id="collapseSeven" class="accordion-collapse collapse" aria-labelledby="headingSeven" data-bs-parent="#faqAccordion">
                <div class="accordion-body">
                    <p class="accordion-text mb-0">Due to the perishable nature of flowers, we do not accept returns. However, if there's an issue, please contact us for assistance.</p>
                </div>
            </div>
        </div>

    </div>
</div>